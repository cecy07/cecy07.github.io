---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}
      <a
        href="{{ 'assets/pdf/202601_Portfolio.pdf' | relative_url }}"
        target="_blank"
        rel="noopener noreferrer"
        class="float-right"
        download
      >
        <i class="fa-solid fa-file-pdf"></i>
      </a>
    </h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>
  <article>
    {{ content }}
  </article>
</div> 